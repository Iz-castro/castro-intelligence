# ============================================================================
# Castro Intelligence CRM - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite .env com valores reais no GitHub!
# ============================================================================

# SEGURANÇA
SECRET_KEY=gerar_com_openssl_rand_hex_32
DEBUG=False
ENVIRONMENT=development

# DATABASE
DATABASE_URL=sqlite:///./castro_crm.db

# WhatsApp Business API
WHATSAPP_TOKEN=seu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_WABA_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=seu_token_verificacao_webhook
WHATSAPP_APP_SECRET=sua_chave_secreta_meta

# Google Cloud
GCP_PROJECT_ID=seu-projeto-gcp

# Segurança
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Autenticação
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# WebSocket
WEBSOCKET_TIMEOUT=30

# Media
MEDIA_PATH=./media
MAX_UPLOAD_SIZE=50
