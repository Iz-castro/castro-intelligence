rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ajuste o dominio abaixo para o dominio real do Google Workspace do cliente.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailDomainOk() {
      return signedIn() && request.auth.token.email.matches('^[^@]+@empresa\\.com\\.br$');
    }

    function myProfileExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/operator_profiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/operator_profiles/$(request.auth.uid));
    }

    function operatorActive() {
      return emailDomainOk() &&
        myProfileExists() &&
        myProfile().data.is_active == 1;
    }

    function isPrivileged() {
      return operatorActive() &&
        (myProfile().data.role == 'admin' || myProfile().data.role == 'supervisor');
    }

    function canSeeConversation(assignedUid, departmentId) {
      return operatorActive() && (
        isPrivileged() ||
        assignedUid == request.auth.uid ||
        assignedUid == '' ||
        departmentId == null ||
        departmentId == myProfile().data.department_id
      );
    }

    match /operator_profiles/{uid} {
      allow read: if emailDomainOk() && (uid == request.auth.uid || operatorActive());
      allow write: if false;
    }

    match /departments/{departmentId} {
      allow read: if operatorActive();
      allow write: if false;
    }

    match /wa_contacts/{contactId} {
      allow read: if canSeeConversation(resource.data.assigned_to_uid, resource.data.department_id);
      allow write: if false;
    }

    match /wa_messages/{messageId} {
      allow read: if canSeeConversation(resource.data.assigned_to_uid, resource.data.department_id);
      allow write: if false;
    }

    match /wa_transfer_log/{transferId} {
      allow read: if canSeeConversation(resource.data.to_user_uid, resource.data.department_id);
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if operatorActive() && (
        resource.data.sender_id == myProfile().data.user_id ||
        resource.data.receiver_id == myProfile().data.user_id
      );
      allow write: if false;
    }

    match /internal_unread/{docId} {
      allow read: if operatorActive() &&
        resource.data.receiver_id == myProfile().data.user_id;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /audit_log/{docId} {
      allow read, write: if false;
    }

    match /wa_message_status/{docId} {
      allow read, write: if false;
    }

    match /_meta/{docId} {
      allow read, write: if false;
    }
  }
}
