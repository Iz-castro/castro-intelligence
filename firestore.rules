rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Estas rules precisam usar o mesmo prefixo definido em FIRESTORE_COLLECTION_PREFIX.
    // No ambiente atual, as collections reais sao "castro_crm_*".
    //
    // M-A4 (multi-tenant): as rules tenant-scoped (castro_crm_tenants/...) autorizam
    // por CLAIM tenant_id + operator_profile ativo — SEM whitelist de email. Um
    // operador de qualquer tenant/dominio acessa apenas o proprio tenant. A whitelist
    // emailAllowed() abaixo permanece SO para as colecoes flat legadas (vazias em
    // Oregon) e o bloco de staging; nao gateia mais nada tenant-scoped.
    // (allowed_email_domains do tenant e guarda-corpo SOFT no provisionamento/
    // roteamento — decisao 2026-07-03 — e nao entra nas rules.)
    function isImpersonation() {
      // Ver como consulta exclusivamente o backend. Marcador malformado tambem
      // nao pode entrar nos grants normais por SDK/REST direto.
      return request.auth != null && request.auth.token.get('imp', false) != false;
    }

    function reservedUid(uid) {
      return uid is string && uid.matches('imp_ro_.*');
    }

    function normalPrincipal() {
      return request.auth != null && !reservedUid(request.auth.uid) && !isImpersonation();
    }

    function signedIn() {
      return normalPrincipal() && request.auth.token.email != null;
    }

    function emailAllowed() {
      return signedIn() && (
        request.auth.token.email == 'rafaluisc@outlook.com' ||
        request.auth.token.email == 'izaeldecastro@gmail.com' ||
        request.auth.token.email == 'castrointelligence@gmail.com' ||
        request.auth.token.email.matches('.*@hubloc\\.com\\.br')
      );
    }

    function myProfileExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/castro_crm_operator_profiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/castro_crm_operator_profiles/$(request.auth.uid));
    }

    function operatorActive() {
      return emailAllowed() &&
        myProfileExists() &&
        myProfile().data.is_active == 1;
    }

    function isPrivileged() {
      return operatorActive() &&
        (myProfile().data.role == 'admin' || myProfile().data.role == 'supervisor');
    }

    // Super-admin da plataforma (Castro Intelligence). Fast-path por claim
    // super_admin (setado pelo scripts/grant_super_admin.py / Cloud Run B).
    // NAO autoriza nada tenant-scoped — as rules do CRM (Cloud Run A) sao
    // cegas a este claim (defense-in-depth §4.1: comprometer o claim nao da
    // acesso cross-tenant via A). Usado SO nas colecoes root de plataforma.
    function isSuperAdmin() {
      return normalPrincipal() && request.auth.token.super_admin == true;
    }

    // ====================================================================
    // Fase 2 — helpers tenant-scoped estritos (PLANO_COEXISTENCE §2.9).
    // Isolamento por tenant+operador via custom claims tenant_id/role no
    // JWT. Claims auditados presentes em 100% dos operadores antes do
    // deploy (scripts/_diag_claims). Backend Admin SDK ignora rules.
    // ====================================================================
    function tokenTenantId() {
      return signedIn() && request.auth.token.tenant_id != null
        ? string(request.auth.token.tenant_id)
        : '';
    }

    function tokenRole() {
      return signedIn() && request.auth.token.role != null
        ? string(request.auth.token.role)
        : '';
    }

    function ownsTenant(tid) {
      // M-A4: autorizacao por claim tenant_id (setado pelo backend no
      // provisionamento, assinado no JWT) — sem whitelist de email, senao
      // operador de tenant novo (dominio proprio/gmail) seria barrado.
      // tokenTenantId() exige signedIn() e claim nao-nulo ('' se ausente,
      // que nunca casa com um {tid} valido do path).
      return tokenTenantId() == tid;
    }

    function isPrivilegedInTenant(tid) {
      return ownsTenant(tid) && (tokenRole() == 'admin' || tokenRole() == 'supervisor');
    }

    function tenantOperatorProfile(tid) {
      return get(/databases/$(database)/documents/castro_crm_tenants/$(tid)/operator_profiles/$(request.auth.uid));
    }

    function tenantOperatorActive(tid) {
      return ownsTenant(tid) &&
        exists(/databases/$(database)/documents/castro_crm_tenants/$(tid)/operator_profiles/$(request.auth.uid)) &&
        (tenantOperatorProfile(tid).data.is_active == 1 ||
         tenantOperatorProfile(tid).data.is_active == true);
    }

    function canSeeContactScoped(tid) {
      // Privilegiado le todos do tenant; operador comum SO atribuidos a si
      // ou sem atribuicao (pool/fila). NAO inclui departamento: a regra por
      // department_id vazava a agenda pessoal (coexistence) de um operador
      // para todos os colegas do mesmo departamento (isolamento LGPD).
      // Backup (is_backup): historico importado, visivel SO a privilegiado
      // (aba Backup). Operador comum nunca le — nem por pool/atribuicao.
      return ownsTenant(tid) && (
        isPrivilegedInTenant(tid) ||
        (resource.data.get('is_backup', false) != true && (
          resource.data.assigned_to_uid == request.auth.uid ||
          resource.data.assigned_to_uid == '' ||
          resource.data.assigned_to_uid == null
        ))
      );
    }

    match /castro_crm_operator_profiles/{uid} {
      allow read: if emailAllowed() && (uid == request.auth.uid || operatorActive());
      allow write: if false;
    }

    match /castro_crm_departments/{departmentId} {
      allow read: if operatorActive();
      allow write: if false;
    }

    match /castro_crm_wa_contacts/{contactId} {
      // Privilegiados (admin/supervisor) veem todos. Operadores: SO
      // atribuidos a si ou sem atribuicao (pool). Sem departamento
      // (isolamento LGPD — ver canSeeContactScoped). Colecao flat legada.
      allow read: if operatorActive() && (
        isPrivileged() ||
        resource.data.assigned_to_uid == request.auth.uid ||
        resource.data.assigned_to_uid == '' ||
        resource.data.assigned_to_uid == null
      );
      allow write: if false;
    }

    match /castro_crm_wa_messages/{messageId} {
      allow read: if operatorActive();
      allow write: if false;
    }

    match /castro_crm_wa_transfer_log/{transferId} {
      allow read: if emailAllowed();
      allow write: if false;
    }

    match /castro_crm_gc_conversations/{convId} {
      allow read: if emailAllowed();
      allow write: if false;
    }

    match /castro_crm_gc_messages/{msgId} {
      allow read: if emailAllowed();
      allow write: if false;
    }

    match /castro_crm_messages/{messageId} {
      allow read: if operatorActive() && (
        resource.data.sender_id == myProfile().data.user_id ||
        resource.data.receiver_id == myProfile().data.user_id
      );
      allow write: if false;
    }

    match /castro_crm_internal_unread/{docId} {
      allow read: if operatorActive() &&
        resource.data.receiver_id == myProfile().data.user_id;
      allow write: if false;
    }

    match /castro_crm_users/{userId} {
      allow read, write: if false;
    }

    match /castro_crm_audit_log/{docId} {
      allow read, write: if false;
    }

    match /castro_crm_wa_message_status/{docId} {
      allow read, write: if false;
    }

    match /castro_crm__meta/{docId} {
      allow read, write: if false;
    }

    // ====================================================================
    // Plataforma super-admin (Sprint 0 — root, fora de qualquer tenant).
    // Escrita SEMPRE via backend Admin SDK (grant_super_admin.py / Cloud
    // Run B), que bypassa rules — cliente nunca escreve. Leitura so pra
    // super-admin (o painel B lista os pares / le a trilha). Colecoes
    // inexistentes ate o --seed; deny-by-default cobre o intervalo.
    // ====================================================================
    match /castro_crm_super_admins/{uid} {
      allow read: if isSuperAdmin() || (normalPrincipal() && request.auth.uid == uid);
      allow write: if false;
    }

    match /castro_crm_audit_logs_system/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ====================================================================
    // PROD — subcolecoes tenant-scoped ESTRITAS (Fase 2, PLANO §2.9).
    // Substitui o bloco permissivo (allow if emailAllowed) que expunha
    // toda a agenda do tenant a qualquer operador autorizado. Frontend
    // ja consome tenant_collections via /api/session; claims
    // tenant_id/role auditados em 100% dos operadores antes do deploy.
    // Subcolecoes nao listadas: deny por padrao (sem match recursivo).
    // ====================================================================

    match /castro_crm_tenants/{tenantId} {
      allow read: if tenantOperatorActive(tenantId);
      allow write: if false;

      match /operator_profiles/{uid} {
        allow read: if ownsTenant(tenantId) && (
          uid == request.auth.uid || isPrivilegedInTenant(tenantId)
        );
        allow write: if false;
      }

      match /users/{userId} {
        allow read, write: if false;
      }

      // Follow-up e historico passam exclusivamente pelo backend, que
      // revalida acesso atual ao contato E a thread em cada operacao.
      match /crm_tasks/{taskId} {
        allow read, write: if false;
      }
      match /crm_activities/{activityId} {
        allow read, write: if false;
      }

      match /departments/{deptId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /perfis_acesso/{perfilId} {
        // RBAC M-B2: perfil = so configuracao de permissao (sem PII).
        // Todo operador le (o frontend assina o proprio perfil em realtime
        // pro can() refletir edicoes ao vivo); escrita SO via backend Admin
        // SDK (CRUD audita + trava perfil_admin). Rules NUNCA leem toggles
        // pra autorizar — o teto continua no claim role (PLANO_RBAC §3.6).
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /wa_contacts/{contactId} {
        allow read: if canSeeContactScoped(tenantId);
        allow write: if false;
      }

      match /wa_conversations/{convId} {
        allow read: if canSeeContactScoped(tenantId);
        allow write: if false;
      }

      match /wa_messages/{messageId} {
        // Backup: mensagens historicas (is_backup denormalizado) so p/
        // privilegiado. Fecha o recorte backup do Vetor B (read amplo de msgs).
        allow read: if ownsTenant(tenantId) &&
          (isPrivilegedInTenant(tenantId) || resource.data.get('is_backup', false) != true);
        allow write: if false;
      }

      match /wa_message_status/{docId} {
        allow read, write: if false;
      }

      match /wa_transfer_log/{transferId} {
        allow read: if isPrivilegedInTenant(tenantId);
        allow write: if false;
      }

      match /bot_states/{convId} {
        allow read, write: if false;
      }

      match /system_settings/{docId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /user_settings/{userId} {
        allow read, write: if false;
      }

      match /audit_log/{docId} {
        allow read: if isPrivilegedInTenant(tenantId);
        allow write: if false;
      }

      match /audit_metrics/{docId} {
        allow read: if isPrivilegedInTenant(tenantId);
        allow write: if false;
      }

      match /health_status/{docId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /gc_conversations/{convId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /gc_messages/{messageId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
      }

      match /internal_unread/{docId} {
        allow read, write: if false;
      }

      match /operator_assume_counters/{userId} {
        allow read, write: if false;
      }

      match /_meta/{docId} {
        allow read, write: if false;
      }

      match /media_assets/{assetId} {
        allow read: if ownsTenant(tenantId);
        allow write: if false;
        match /chunks/{chunkId} {
          allow read: if ownsTenant(tenantId);
          allow write: if false;
        }
      }
      match /impersonation_sessions/{sid} {
        allow read, write: if false;
      }
    }

    // ====================================================================
    // STAGING (FIRESTORE_COLLECTION_PREFIX=castro_crm_staging)
    // Rules permissivas para sessoes normais. Ver como nunca le nem escreve
    // por SDK/REST direto: toda leitura temporaria passa pelo backend.
    // Sera substituido por regras tenant-based na Fase 2 (subcolecao
    // tenants/{tenant_id}/* com claim no JWT).
    // ====================================================================

    match /castro_crm_staging_operator_profiles/{uid} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_users/{userId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_departments/{deptId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_channels/{channelId} {
      // Metadados de canal participam da autorizacao da pool no follow-up.
      // emailAllowed() ja exclui o Ver como (signedIn -> normalPrincipal).
      allow read: if emailAllowed() && ownsTenant(resource.data.tenant_id);
      allow write: if false;
    }

    match /castro_crm_staging_wa_contacts/{contactId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_wa_conversations/{convId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_wa_messages/{messageId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_wa_message_status/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_wa_transfer_log/{transferId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_bot_states/{convId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_system_settings/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_user_settings/{userId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_audit_log/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_audit_metrics/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_operator_assume_counters/{userId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_media_assets/{assetId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
      match /chunks/{chunkId} {
        allow read: if emailAllowed();
        allow write: if emailAllowed() && !isImpersonation();
      }
    }

    match /castro_crm_staging_gc_conversations/{convId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_gc_messages/{msgId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_messages/{messageId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging_internal_unread/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    match /castro_crm_staging__meta/{docId} {
      allow read: if emailAllowed();
      allow write: if emailAllowed() && !isImpersonation();
    }

    // Doc do tenant em si (lista de tenants ainda flat, indice global).
    match /castro_crm_staging_tenants/{tenantId} {
      allow read: if emailAllowed() && ownsTenant(tenantId);
      allow write: if false;

      // Nao usar wildcard permissivo: um deny especifico nao revoga outro
      // allow (regras somam com OU). Escritas via Admin SDK; tarefas e
      // historico do follow-up so pelo backend. O registro do Ver como
      // (impersonation_sessions) e server-only e PRECISA estar na lista: o
      // match especifico mais abaixo nao revoga o wildcard. Colecoes so de
      // backend com dados pessoais tambem ficam fora. O frontend le pelo SDK
      // so wa_contacts, wa_conversations, wa_messages, gc_*, perfis_acesso e
      // departments. emailAllowed() ja exclui o Ver como (normalPrincipal).
      match /{subcol}/{document=**} {
        allow read: if emailAllowed() && ownsTenant(tenantId)
          && !(subcol in ['crm_tasks', 'crm_activities', 'users', 'audit_log',
                         'bot_states', 'wa_message_status', 'internal_unread',
                         'operator_assume_counters', '_meta', 'wa_contacts',
                         'wa_conversations', 'wa_messages', 'impersonation_sessions',
                         'user_settings', 'webhook_raw_debug', 'bot_buffers',
                         'wa_contact_index', 'wa_message_index', 'attendances_daily',
                         'reopen_batches']);
        allow write: if false;
      }
      match /wa_contacts/{contactId} {
        allow read: if emailAllowed() && canSeeContactScoped(tenantId);
        allow write: if false;
      }
      match /wa_conversations/{conversationId} {
        allow read: if emailAllowed() && canSeeContactScoped(tenantId);
        allow write: if false;
      }
      match /wa_messages/{messageId} {
        allow read: if emailAllowed() && ownsTenant(tenantId)
          && (isPrivilegedInTenant(tenantId) || resource.data.get('is_backup', false) != true)
          && (isPrivilegedInTenant(tenantId) || resource.data.get('visibility', 'all') != 'admin_only');
        allow write: if false;
      }
      match /impersonation_sessions/{sid} {
        allow read, write: if false;
      }
    }
  }
}
